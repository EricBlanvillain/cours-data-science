---
/**
 * Le cours complet, fait pour être imprimé (scripts/pdf.mjs en tire public/pdf/cours-complet.pdf) : une couverture, un
 * sommaire cliquable, puis les leçons des séances 0 à 12 dans l'ordre, chacune sur une nouvelle page, avec le même corps
 * que sa page (CorpsLecon). Sans les modules optionnels. La page n'est liée nulle part et n'est pas indexée.
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import CorpsLecon from "../components/CorpsLecon.astro";

const lecons = (await getCollection("lecons")).filter((l) => l.data.numero <= 12).sort((a, b) => a.data.numero - b.data.numero);
const nn = (n: number) => String(n).padStart(2, "0");
---

<Base titre="Cours complet" description="Le cours Data Science & IA, séances 0 à 12, en une page à imprimer." noindex>
  <section class="couverture" style="padding-top: 6rem;">
    <p class="mono-caps" style="color: var(--encre-2);">Cours · notebooks et exercices sur GitHub</p>
    <h1 class="hero-titre" style="margin-top: 1rem;">Data Science &amp; IA · {lecons.length} séances</h1>
    <p style="max-width: 40rem; margin-top: 2rem;">Comprendre les données et l'IA, en construisant. Python, données, machine learning, puis l'IA générative.</p>
    <p class="discret" style="margin-top: 1.5rem;">https://cours-data-science.vercel.app</p>
  </section>

  <nav class="sommaire-cours mt-10" aria-label="Sommaire du cours">
    <h2>Sommaire</h2>
    <ol class="mt-4" style="list-style: none; padding: 0;">
      {lecons.map((l) => (
        <li class="mt-2"><a href={`#seance-${nn(l.data.numero)}`}><span class="mono-caps">Séance {nn(l.data.numero)}</span> · {l.data.titre}</a></li>
      ))}
    </ol>
  </nav>

  {lecons.map((l) => (
    <section class="lecon-imprimee mt-16" id={`seance-${nn(l.data.numero)}`}>
      <header class="lecon-entete">
        <p class="mono-caps" style="color: var(--encre-2);">Séance {nn(l.data.numero)} · {l.data.niveau.replace(/⭐/g, "★")} · {l.data.duree}</p>
        <h1 class="hero-titre mt-2">{l.data.titre}</h1>
        <p class="mt-3" style="max-width: 46rem;">{l.data.resume}</p>
      </header>
      <CorpsLecon lecon={l} />
    </section>
  ))}
</Base>
