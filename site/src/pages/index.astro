---
import Base from "../layouts/Base.astro";
import GrilleCartes from "../components/GrilleCartes.astro";
import { getCollection } from "astro:content";
import { seances, blocs, DEPOT } from "../data/seances";
import { libelleModule, trierModules } from "../data/modules";

const parBloc = [0, 1, 2, 3, 4].map((b) => ({
  bloc: b as keyof typeof blocs,
  titre: blocs[b as keyof typeof blocs],
  liste: seances.filter((s) => s.bloc === b),
}));
const total = seances.length;
// les modules optionnels : la collection est la seule liste ; une carte n'apparaît qu'avec sa page
const modules = trierModules(await getCollection("modules"));
const groupesModules = [
  { titre: "Séances optionnelles", intro: null, liste: modules.filter((m) => m.data.type === "seance") },
  { titre: "Projets d'IA agentique", intro: "Prérequis conseillés : les séances 9 à 12. B4 se fait après B1 ou B2.", liste: modules.filter((m) => m.data.type === "projet") },
].filter((g) => g.liste.length > 0);
---

<Base titre="Les séances" largeur="large">
  {/* Ouverture sombre : le compteur des séances restantes, en cuivre comme tout ce qui n'est pas encore fait. */}
  <section slot="hero" class="sombre hero">
    <div class="conteneur">
      <p class="etiquette">Cours Data Science &amp; IA · {total} séances de 1 h 30</p>
      <h1 class="hero-titre">Comprendre les données et l'IA, en construisant.</h1>
      <p class="hero-texte">
        Python, données, machine learning, puis l'IA générative. Quinze minutes d'explication, une heure de pratique,
        quinze minutes de partage. Ce site porte l'explication ; la pratique se fait dans les notebooks.
      </p>
      <p class="hero-compteur" data-compteur data-fini="non">
        <span class="hero-compteur-nombre ouvert" data-restantes>{total}</span>
        <span class="mono-caps" data-restantes-mot>séances restantes</span>
      </p>
      <p class="hero-ligne mono-caps">Portfolio GitHub · score Kaggle · un assistant IA construit soi-même</p>
    </div>
  </section>

  {/* La seule entrée d'export : la page « Enregistrer en PDF » laisse choisir le cours complet ou des séances. */}
  <p class="pt-8"><a href="/enregistrer-pdf" class="bouton no-underline">Enregistrer en PDF ↓</a></p>

  <div class="space-y-16 pt-14">
    {parBloc.map(({ titre, liste }) => (
      <section>
        <h2 class="mono-caps" style="font-family: var(--font-mono); font-size: 0.78rem; font-weight: 500; color: var(--encre-2);">{titre}</h2>
        {/* Cinq bandes alignées sur toute la rangée : sur-titre, titre, description, pied, action.
            Le pied répond à deux questions distinctes : ce qui est disponible sur le site (ne change jamais) et où en est
            l'élève (cuivre sur toute séance pas encore terminée, vert une fois terminée ; « leçon à écrire » en rouge). La bande d'action garde sa hauteur même vide :
            une séance pas encore faite n'annonce pas la porte, le titre reste cliquable, rien n'est bloqué. */}
        <GrilleCartes bandes={5} class="mt-5">
          {liste.map((s) => {
            const lecon = s.slug ? `/lecons/${s.slug}` : null;
            const notebooks = `${DEPOT}/tree/main/seances/${s.dossier}`;
            return (
            <li class="carte carte-seance" data-seance={s.numero}>
              <div class="flex items-baseline justify-between gap-3 mono-caps">
                <span>Séance {String(s.numero).padStart(2, "0")}</span>
                <span aria-label={`niveau ${s.niveau}`}>{s.niveau}</span>
              </div>
              <h3>
                {lecon ? <a href={lecon} class="no-underline" style="color: var(--encre);">{s.titre}</a> : s.titre}
              </h3>
              <p class="discret" style="font-size: 0.95rem;">{s.resume}</p>
              <div class="pied-seance pt-3">
                <p class:list={["mono-caps dispo-seance", !lecon && "sans-lecon"]}>{lecon ? "Leçon en ligne · notebooks" : "Notebooks seuls · leçon à écrire"}</p>
                <p class="mono-caps etat-seance mt-1">
                  <span class="pastille" aria-hidden="true"></span><span data-etat-libelle>Pas encore faite</span>
                </p>
              </div>
              <div class="bande-action">
                {lecon ? (
                  <>
                    <a href={lecon} class="bouton principal no-underline action-ouverte">Ouvrir la leçon →</a>
                    <a href={lecon} class="lien-mono action-terminee">Relire la leçon →</a>
                  </>
                ) : (
                  <>
                    <a href={notebooks} class="bouton no-underline action-ouverte" target="_blank" rel="noopener">Ouvrir les notebooks ↗</a>
                    <a href={notebooks} class="lien-mono action-terminee" target="_blank" rel="noopener">Revoir les notebooks ↗</a>
                  </>
                )}
              </div>
            </li>
            );
          })}
        </GrilleCartes>
      </section>
    ))}

    <div>
      <p class="discret" style="max-width: 46rem;">
        Une séance terminée ouvre la suivante : c'est un garde-fou, pas une serrure. Tout s'affiche toujours, et l'état est gardé
        dans ce navigateur, sur cet appareil. Sur une autre machine, on repart de zéro : c'est normal.
      </p>
    </div>

    {/* Les modules optionnels : même grille, même anatomie de carte, deux groupes. Pas de data-seance, donc hors de la
        progression, du compteur « séances restantes » et de la barre de progression. Leur pied est neutre, sans pastille :
        une page en ligne, hors parcours. La section n'existe que si la collection a au moins une page. */}
    {groupesModules.length > 0 && (
      <section>
        <h2 class="mono-caps" style="font-family: var(--font-mono); font-size: 0.78rem; font-weight: 500; color: var(--encre-2);">Modules optionnels</h2>
        <p class="discret mt-2" style="font-size: 0.95rem;">En plus des séances 0 à 12, hors parcours : pour aller plus loin, quand on veut.</p>
        {groupesModules.map((g) => (
          <div class="mt-8">
            <h3 class="mono-caps" style="font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; color: var(--encre-2);">{g.titre}</h3>
            {g.intro && <p class="discret mt-1" style="font-size: 0.95rem;">{g.intro}</p>}
            <GrilleCartes bandes={5} class="mt-4">
              {g.liste.map((m) => (
                <li class="carte carte-module">
                  <div class="flex items-baseline justify-between gap-3 mono-caps">
                    <span>{libelleModule(m.data)}</span>
                    <span aria-label={`niveau ${m.data.niveau}`}>{m.data.niveau}</span>
                  </div>
                  <h3><a href={`/modules/${m.id}`} class="no-underline" style="color: var(--encre);">{m.data.titre}</a></h3>
                  <p class="discret" style="font-size: 0.95rem;">{m.data.resume}</p>
                  <div class="pt-3">
                    <p class="mono-caps dispo-seance">{m.data.type === "seance" ? "Leçon en ligne · module optionnel" : "Projet en ligne · module optionnel"}</p>
                  </div>
                  <div class="bande-action">
                    <a href={`/modules/${m.id}`} class="bouton no-underline">{m.data.type === "seance" ? "Ouvrir la leçon →" : "Ouvrir le projet →"}</a>
                  </div>
                </li>
              ))}
            </GrilleCartes>
          </div>
        ))}
      </section>
    )}
  </div>

</Base>
