---
/**
 * Le journal des corrections tel que le notebook l'écrit, puis la preuve : le tableau réparé comparé au tableau propre
 * d'origine (src/data/nettoyage.ts).
 */
import { journal, apresDoublons, typesValides, verification } from "../../data/nettoyage";
const X = 40, Y = 84, PAS = 28;
const comparaison = [
  { quoi: "lignes", propre: "800", repare: String(apresDoublons) },
  { quoi: "types de Type 1", propre: String(typesValides), repare: `${verification.typesAvecInconnu}, dont « Inconnu »` },
  { quoi: "HP moyen", propre: String(verification.hpMoyenPropre).replace(".", ","), repare: String(verification.hpMoyenRepare).replace(".", ",") },
];
---
<figure class="large">
  <svg class="schema grand" viewBox="0 0 960 330" role="img" aria-labelledby="jc-titre jc-desc">
    <title id="jc-titre">Le journal des corrections, puis la preuve</title>
    <desc id="jc-desc">À gauche, les sept lignes du journal : départ à 810 lignes et 471 cases vides, 10 doublons supprimés, 12 fautes corrigées pour 18 types, HP converti en nombre, 40 HP remplis par la médiane 65, Type 1 vides remplacés par Inconnu, dates converties. À droite, la comparaison avec le tableau propre : 800 lignes des deux côtés, 18 types contre 19 dont Inconnu, HP moyen 69,3 contre 69,1.</desc>

    <text x={X} y="34" class="encre" font-size="16" font-weight="700">1. le journal, une ligne par réparation</text>
    <text x={X} y="54" class="encre-2" font-size="12.5">ce que le notebook affiche à la fin, dans l'ordre</text>
    <rect x={X - 12} y={Y - 22} width="596" height={PAS * journal.length + 14} class="fond-3 trait" stroke-width="1.5" />
    {journal.map((l, i) => (
      <g>
        <text x={X} y={Y + i * PAS} class="encre-2 mono" font-size="12">{i + 1}.</text>
        <text x={X + 24} y={Y + i * PAS} class="encre mono" font-size="10">{l}</text>
      </g>
    ))}

    <text x="660" y="34" class="encre" font-size="16" font-weight="700">2. la preuve</text>
    <text x="660" y="54" class="encre-2" font-size="12.5">le tableau réparé face au tableau propre</text>
    <rect x="660" y="62" width="280" height="24" class="plein" />
    <text x="772" y="79" class="sur-plein mono" font-size="12" font-weight="700">propre</text>
    <text x="846" y="79" class="sur-plein mono" font-size="12" font-weight="700">réparé</text>
    {comparaison.map((c, i) => (
      <g>
        <rect x="660" y={86 + i * 44} width="280" height="44" class={i % 2 ? "fond-3" : "fond-2"} />
        <text x="670" y={112 + i * 44} class="encre" font-size="12.5">{c.quoi}</text>
        <text x="772" y={112 + i * 44} class="encre mono" font-size="12.5">{c.propre}</text>
        <text x="846" y={(c.repare.includes(", ") ? 106 : 112) + i * 44} class="encre mono" font-size="12.5">{c.repare.split(", ")[0]}</text>
        {c.repare.includes(", ") && <text x="846" y={122 + i * 44} class="encre-2" font-size="11">{c.repare.split(", ")[1]}</text>}
      </g>
    ))}
    <text x="660" y="248" class="encre-2" font-size="12">L'écart de HP vient des 40 cases remplies par 65 :</text>
    <text x="660" y="266" class="encre-2" font-size="12">le journal dit pourquoi le chiffre a bougé.</text>
  </svg>
  <figcaption>Chaque réparation s'écrit ; le tableau réparé se compare au tableau d'origine.</figcaption>
</figure>
