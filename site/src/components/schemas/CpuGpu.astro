---
/**
 * CPU contre GPU, en un schéma : peu de cœurs rapides et polyvalents d'un côté, des milliers de cœurs lents et
 * identiques de l'autre, et la même multiplication de matrice traitée par les deux. Remplace l'ancienne section de prose.
 */
const gpuCols = 24, gpuRows = 8;
---
<figure class="large">
  <svg class="schema grand" viewBox="0 0 920 380" role="img" aria-labelledby="cg-titre cg-desc">
    <title id="cg-titre">Processeur contre carte graphique</title>
    <desc id="cg-desc">À gauche, un processeur : huit gros cœurs, rapides et polyvalents, qui traitent les cases d'une multiplication de matrice l'une après l'autre. À droite, une carte graphique : des milliers de petits cœurs identiques, qui traitent toutes les cases en même temps.</desc>

    <!-- CPU -->
    <text x="230" y="36" text-anchor="middle" class="encre" font-size="21" font-weight="700">Processeur (CPU)</text>
    <text x="230" y="60" text-anchor="middle" class="encre-2" font-size="14.5">quelques cœurs, rapides, bons à tout</text>
    <rect x="90" y="78" width="280" height="150" class="fond-2 trait" stroke-width="2" />
    {Array.from({ length: 8 }, (_, i) => (
      <rect x={104 + (i % 4) * 66} y={92 + Math.floor(i / 4) * 66} width="56" height="56" class="fond-3 plein-trait" stroke-width="2" />
    ))}
    <text x="230" y="254" text-anchor="middle" class="encre" font-size="15" font-weight="700">une case après l'autre</text>

    <!-- GPU -->
    <text x="660" y="36" text-anchor="middle" class="encre" font-size="21" font-weight="700">Carte graphique (GPU)</text>
    <text x="660" y="60" text-anchor="middle" class="encre-2" font-size="14.5">des milliers de cœurs, lents, tous identiques</text>
    <rect x="470" y="78" width="380" height="150" class="fond-2 trait" stroke-width="2" />
    {Array.from({ length: gpuCols * gpuRows }, (_, i) => (
      <rect x={480 + (i % gpuCols) * 15} y={88 + Math.floor(i / gpuCols) * 16.5} width="11" height="11" class="plein" />
    ))}
    <text x="660" y="254" text-anchor="middle" class="encre" font-size="15" font-weight="700">toutes les cases en même temps</text>

    <!-- la même multiplication de matrice, en bas : 4 × 4 cases -->
    <g class="encre-2" font-size="13.5" text-anchor="middle">
      <text x="230" y="296">la même multiplication de matrices, 16 cases à calculer</text>
      <text x="660" y="296">la même multiplication de matrices, 16 cases à calculer</text>
    </g>
    {Array.from({ length: 16 }, (_, i) => (
      <g>
        <rect x={166 + (i % 4) * 32} y={306 + Math.floor(i / 4) * 16} width="28" height="12" class={i === 0 ? "plein" : "fond-3 trait"} stroke-width="1" />
        <rect x={596 + (i % 4) * 32} y={306 + Math.floor(i / 4) * 16} width="28" height="12" class="plein" />
      </g>
    ))}
    <text x="230" y="376" text-anchor="middle" class="encre-2 mono" font-size="12">1, puis 2, puis 3… puis 16</text>
    <text x="660" y="376" text-anchor="middle" class="encre-2 mono" font-size="12">16 d'un coup</text>
  </svg>
  <figcaption>Un réseau de neurones ne fait presque que des multiplications de matrices, toutes identiques : le GPU les fait toutes en même temps.</figcaption>
</figure>
