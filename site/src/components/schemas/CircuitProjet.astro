---
/**
 * Le circuit d'un projet (pages B1 à B4) : une rangée d'étapes, de l'entrée au résultat, l'étape clé en plein. Les
 * étapes viennent de la page (tirées du README et du notebook du projet) ; aucun chiffre qui ne vienne pas d'eux.
 */
interface Etape { mot: string; ligne: string; sous?: string }
interface Props {
  /** titre accessible du schéma */
  titre: string;
  etapes: Etape[];
  /** index de l'étape mise en plein (celle que le projet fait construire en premier lieu) */
  cle?: number;
  legende: string;
}
const { titre, etapes, cle = -1, legende } = Astro.props;
const n = etapes.length;
const pas = 920 / n;
const largeur = pas - 16;
const id = "cp-" + titre.toLowerCase().normalize("NFD").replace(/[^a-z0-9]+/g, "-").slice(0, 24);
const desc = etapes.map((e, i) => `${i + 1}. ${e.mot} : ${e.ligne}${e.sous ? ", " + e.sous : ""}`).join(" ; ");
---
<figure class="large">
  <svg class="schema grand" viewBox="0 0 960 140" role="img" aria-labelledby={`${id}-titre ${id}-desc`}>
    <title id={`${id}-titre`}>{titre}</title>
    <desc id={`${id}-desc`}>{desc}</desc>
    {etapes.map((e, i) => (
      <g>
        <rect x={20 + i * pas} y="20" width={largeur} height="100" class={i === cle ? "plein" : "fond-2 plein-trait"} stroke-width="1.5" />
        <text x={32 + i * pas} y="42" class={(i === cle ? "sur-plein" : "encre-2") + " mono"} font-size="11.5">{i + 1}</text>
        <text x={32 + i * pas} y="66" class={i === cle ? "sur-plein" : "encre"} font-size="15" font-weight="700">{e.mot}</text>
        <text x={32 + i * pas} y="86" class={i === cle ? "sur-plein" : "encre"} font-size="12">{e.ligne}</text>
        {e.sous && <text x={32 + i * pas} y="104" class={i === cle ? "sur-plein" : "encre-2"} font-size="11">{e.sous}</text>}
        {i < n - 1 && <path d={`M${20 + i * pas + largeur + 2} 70 H${20 + (i + 1) * pas - 2}`} class="trait" stroke-width="2" fill="none" />}
      </g>
    ))}
  </svg>
  <figcaption>{legende}</figcaption>
</figure>
