---
/**
 * Les cinq étapes du métier (notebook 04, section 1), et la part de la journée qui part dans les deux premières selon
 * l'enquête Anaconda 2020 (src/data/nettoyage.ts). Les deux étapes du jour sont pleines ; les suivantes disent leur séance.
 */
import { ANACONDA } from "../../data/nettoyage";
const etapes = [
  { mot: "Collecte", ligne: "fichier, base, API", seance: "aujourd'hui" },
  { mot: "Nettoyage", ligne: "trous, doublons, formats", seance: "aujourd'hui" },
  { mot: "Analyse", ligne: "questions, graphiques", seance: "séance 5" },
  { mot: "Modélisation", ligne: "un modèle qui prédit", seance: "séance 6" },
  { mot: "Restitution", ligne: "raconter à qui décide", seance: "séance 5" },
];
const X0 = 40, L = 160, PAS = 180;
const X100 = 880 - X0;   // largeur de la barre des 100 %
---
<figure class="large">
  <svg class="schema grand" viewBox="0 0 920 300" role="img" aria-labelledby="ce-titre ce-desc">
    <title id="ce-titre">Les cinq étapes du métier de data scientist</title>
    <desc id="ce-desc">Cinq cases en chaîne : collecte, nettoyage, analyse, modélisation, restitution. Les deux premières sont le sujet du jour. Dessous, une barre : selon l'enquête Anaconda 2020, près de la moitié de la journée, 45 %, part à charger et nettoyer les données.</desc>
    {etapes.map((e, i) => {
      const x = X0 + i * PAS; const jour = i < 2;
      return (
        <g>
          <rect x={x} y="30" width={L} height="92" class={jour ? "plein" : "fond-2 trait"} stroke-width="1.5" />
          <text x={x + 14} y="54" class={(jour ? "sur-plein" : "encre-2") + " mono"} font-size="12">{i + 1}</text>
          <text x={x + 14} y="80" class={jour ? "sur-plein" : "encre"} font-size="17" font-weight="700">{e.mot}</text>
          <text x={x + 14} y="104" class={jour ? "sur-plein" : "encre-2"} font-size="12">{e.ligne}</text>
          <text x={x + L / 2} y="144" text-anchor="middle" class={jour ? "encre" : "encre-2"} font-size="12" font-weight={jour ? "700" : "400"}>{e.seance}</text>
          {i < etapes.length - 1 && <g class="trait" stroke-width="2" fill="none"><path d={`M${x + L + 3} 76 H${x + PAS - 7}`} /><path d={`M${x + PAS - 12} 71 L${x + PAS - 4} 76 L${x + PAS - 12} 81`} /></g>}
        </g>
      );
    })}

    <text x={X0} y="196" class="encre" font-size="14" font-weight="700">Où passe une journée de travail</text>
    <rect x={X0} y="208" width={X100} height="30" class="fond-2 trait" stroke-width="1.5" />
    <rect x={X0} y="208" width={X100 * ANACONDA.preparation / 100} height="30" class="plein" />
    <text x={X0 + 12} y="228" class="sur-plein" font-size="13" font-weight="700">charger et nettoyer : {ANACONDA.preparation} %</text>
    <text x={X0 + X100 * ANACONDA.preparation / 100 + 12} y="228" class="encre-2" font-size="13">le reste : graphiques, modèles, mise en service</text>
    <text x={X0} y="266" class="encre-2" font-size="12">Enquête Anaconda 2020, {ANACONDA.repondants} répondants : {ANACONDA.chargement} % pour charger, plus d'un quart pour nettoyer.</text>
  </svg>
  <figcaption>Cinq étapes, et près de la moitié du temps passe dans les deux premières.</figcaption>
</figure>
