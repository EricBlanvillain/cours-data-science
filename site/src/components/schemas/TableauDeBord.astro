---
/**
 * Le mini-dashboard Pokémon du notebook 05 (section 6), dessiné à la main sur les mêmes données (src/data/analyse.ts et
 * src/data/pokemon.ts) : un menu qui choisit la stat, trois graphiques côte à côte (make_subplots), des titres qui
 * disent ce qu'on regarde. Ici figé sur la stat HP ; dans Colab, le menu et le survol sont vivants.
 */
import { hpParType, parGeneration } from "../../data/analyse";
import { nuage } from "../../data/pokemon";
const P = [{ x: 40, w: 280 }, { x: 350, w: 260 }, { x: 640, w: 280 }];
const Y0 = 120, HT = 160;
const bw1 = P[0].w / hpParType.length;
const bw3 = P[2].w / parGeneration.length;
---
<figure class="large">
  <svg class="schema grand" viewBox="0 0 960 380" role="img" aria-labelledby="tb-titre tb-desc">
    <title id="tb-titre">Un tableau de bord Plotly : un menu et trois graphiques</title>
    <desc id="tb-desc">Un cadre titré « Mini-dashboard Pokémon ». En haut à gauche, un menu déroulant réglé sur HP. Trois graphiques côte à côte : les HP moyens par type, de Dragon 83,3 à Bug 56,9 ; l'attaque contre la défense des 800 Pokémon ; le nombre de Pokémon par génération, de 166 à 82.</desc>
    <rect x="20" y="10" width="920" height="350" class="fond-2 trait" stroke-width="1.5" />
    <text x="40" y="40" class="encre" font-size="15" font-weight="700">Mini-dashboard Pokémon : choisis la stat dans le menu</text>
    <rect x="40" y="52" width="92" height="24" class="fond-3 plein-trait" stroke-width="1.5" />
    <text x="50" y="69" class="encre mono" font-size="12">HP ▾</text>
    <text x="144" y="69" class="encre-2" font-size="11.5">le menu (updatemenus) change la stat du premier graphique : HP, Attack, Defense, Speed</text>

    <text x={P[0].x} y={Y0 - 6} class="encre" font-size="12" font-weight="700">HP moyen par type</text>
    {hpParType.map((t, i) => <rect x={P[0].x + i * bw1 + 1} y={Y0 + HT * (1 - t.hp / 100)} width={bw1 - 2} height={HT * t.hp / 100} class={i === 0 ? "plein" : "fond-3 plein-trait"} stroke-width="1" />)}
    <text x={P[0].x} y={Y0 + HT * (1 - hpParType[0].hp / 100) - 6} class="encre" font-size="11" font-weight="600">{hpParType[0].type} {String(hpParType[0].hp).replace(".", ",")}</text>
    <line x1={P[0].x} x2={P[0].x + P[0].w} y1={Y0 + HT} y2={Y0 + HT} class="plein-trait" stroke-width="1" />
    <text x={P[0].x} y={Y0 + HT + 18} class="encre-2" font-size="11">18 types, de {hpParType[0].type} à {hpParType[hpParType.length - 1].type} ({String(hpParType[hpParType.length - 1].hp).replace(".", ",")})</text>

    <text x={P[1].x} y={Y0 - 6} class="encre" font-size="12" font-weight="700">Attaque vs Défense</text>
    <rect x={P[1].x} y={Y0} width={P[1].w} height={HT} class="fond" fill="none" />
    {nuage.map(([a, d]) => <circle cx={P[1].x + P[1].w * Math.min(a, 200) / 200} cy={Y0 + HT * (1 - Math.min(d, 250) / 250)} r="1.6" class="plein" opacity="0.4" />)}
    <line x1={P[1].x} x2={P[1].x + P[1].w} y1={Y0 + HT} y2={Y0 + HT} class="plein-trait" stroke-width="1" />
    <text x={P[1].x} y={Y0 + HT + 18} class="encre-2" font-size="11">un point par Pokémon ; au survol, son nom</text>

    <text x={P[2].x} y={Y0 - 6} class="encre" font-size="12" font-weight="700">Nombre par génération</text>
    {parGeneration.map((n, i) => (
      <g>
        <rect x={P[2].x + i * bw3 + 4} y={Y0 + HT * (1 - n / 200)} width={bw3 - 8} height={HT * n / 200} class="fond-3 plein-trait" stroke-width="1" />
        <text x={P[2].x + i * bw3 + bw3 / 2} y={Y0 + HT * (1 - n / 200) - 5} text-anchor="middle" class="encre mono" font-size="10.5">{n}</text>
        <text x={P[2].x + i * bw3 + bw3 / 2} y={Y0 + HT + 14} text-anchor="middle" class="encre-2 mono" font-size="10.5">{i + 1}</text>
      </g>
    ))}
    <line x1={P[2].x} x2={P[2].x + P[2].w} y1={Y0 + HT} y2={Y0 + HT} class="plein-trait" stroke-width="1" />
    <text x={P[2].x} y={Y0 + HT + 30} class="encre-2" font-size="11">générations 1 à 6</text>
    <text x="40" y="346" class="encre-2" font-size="11.5">make_subplots(rows=1, cols=3) : une rangée, trois cases ; chaque graphique répond à une question du client.</text>
  </svg>
  <figcaption>Un tableau de bord rassemble trois ou quatre graphiques qui répondent aux questions d'un client.</figcaption>
</figure>
