---
/**
 * La rangée de boutons d'une séance : la leçon dans Colab, le carnet d'exercices dans Colab, le dossier sur GitHub.
 * Trois destinations externes, donc ↗ (convention du site). Les URL se construisent depuis le dépôt et le dossier de la
 * séance : un seul endroit à corriger si le dépôt bouge. Même composant sur toutes les leçons. À l'impression, les trois
 * boutons deviennent des liens cliquables, suivis de leur adresse courte (data-adresse).
 */
import { DEPOT } from "../data/seances";

interface Props {
  /** nom du dossier sous `racine` */
  dossier: string;
  /** dossier parent dans le dépôt : seances (défaut), seances-optionnelles, projets-optionnels/… */
  racine?: string;
  /** nom du fichier de la leçon, ex. 02_python_pour_la_data.ipynb */
  lecon: string;
  /** nom du carnet d'exercices, ex. 02_exercices.ipynb ; absent pour un projet (pas de carnet d'exercices) */
  exercices?: string;
  /** libellé du premier bouton : « Ouvrir la leçon dans Colab » (défaut) ou « Ouvrir le notebook dans Colab » */
  libelle?: string;
  nbExercices?: number;
}
const { dossier, racine = "seances", lecon, exercices, nbExercices = 12, libelle = "Ouvrir la leçon dans Colab" } = Astro.props;
const colab = (fichier: string) => `https://colab.research.google.com/github/EricBlanvillain/cours-data-science/blob/main/${racine}/${dossier}/${fichier}`;
const courtColab = (fichier: string) => `colab.research.google.com/…/${fichier}`;
const courtGithub = `github.com/EricBlanvillain/cours-data-science/…/${dossier}`;
---
<p class="large boutons-seance">
  <a class="bouton principal" href={colab(lecon)} data-adresse={courtColab(lecon)} target="_blank" rel="noopener">{libelle} ↗</a>
  {exercices && <a class="bouton" href={colab(exercices)} data-adresse={courtColab(exercices)} target="_blank" rel="noopener">Les {nbExercices} exercices ↗</a>}
  <a class="bouton" href={`${DEPOT}/tree/main/${racine}/${dossier}`} data-adresse={courtGithub} target="_blank" rel="noopener">Le dossier sur GitHub ↗</a>
</p>
