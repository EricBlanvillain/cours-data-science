---
/** Les trois cartes « Pourquoi maintenant », alimentées par src/data/causes.ts.
 *  Le graphique porte l'information ; sous lui, une légende d'une ligne ; tout le reste (explication, chiffres
 *  secondaires, sources) est derrière « détails et sources ». min 14rem : trois cartes de front dès 1280 px. */
import { causes } from "../data/causes";
import GrilleCartes from "./GrilleCartes.astro";
import Courbe from "./schemas/Courbe.astro";
---
{causes.length === 0 ? (
  <p class="encart">Les cartes n'ont pas encore de données : remplis <code>src/data/causes.ts</code>.</p>
) : (
  <GrilleCartes bandes={5} liste={false} class="large" min="14rem">
    {causes.map((c, i) => (
      <article class="carte">
        <p class="etiquette">Cause {i + 1}</p>
        <h3>{c.titre}</h3>
        <Courbe id={`courbe-${c.id}`} titre={c.serie.titre} points={c.serie.points} unite={c.serie.unite} log={c.serie.log} annotation={c.serie.annotation} />
        <p class="discret">{c.serie.legende}</p>
        <details class="bande-pied pt-2">
          <summary class="lien-source" style="list-style: none; display: inline;">détails et sources</summary>
          <p class="mt-2" style="font-size: 0.92rem;">{c.explication}</p>
          <ul class="mt-2 pl-5" style="font-size: 0.88rem;">
            {c.details.map((d) => <li class="mt-1">{d}</li>)}
          </ul>
          <p class="discret mt-2" style="font-size: 0.8rem;">
            <a href={c.source} target="_blank" rel="noopener">{c.sourceTitre} ↗</a> · vérifié le {c.verifie}
            {c.sourcesComplementaires?.length ? (
              <span>
                <br />aussi :{" "}
                {c.sourcesComplementaires.map((s, k) => (
                  <span>{k > 0 && " · "}<a href={s.url} target="_blank" rel="noopener">{s.titre}</a></span>
                ))}
              </span>
            ) : null}
          </p>
        </details>
      </article>
    ))}
  </GrilleCartes>
)}
